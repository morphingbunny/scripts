   "manifest_version": 3,
   "minimum_chrome_version": "99",
   "name": "__MSG_name__",
   "optional_host_permissions": [ "\u003Call_urls>" ],
   "options_page": "core/options.html",
   "permissions": [ "activeTab", "tabs", "contextMenus", "unlimitedStorage", "storage", "favicon" ],
