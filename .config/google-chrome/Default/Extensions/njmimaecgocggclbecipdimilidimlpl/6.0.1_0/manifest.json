{
   "content_scripts": [ {
      "css": [ "css/comment-collapser.css" ],
      "js": [ "js/comment-collapser.js" ],
      "matches": [ "http://*.reddit.com/*/comments/*", "https://*.reddit.com/*/comments/*" ],
      "run_at": "document_start"
   } ],
   "description": "A more elegant solution for collapsing reddit comment trees",
   "host_permissions": [ "https://*.reddit.com/" ],
   "icons": {
      "128": "image/icon128.png",
      "48": "image/icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "minimum_chrome_version": "88",
   "name": "Reddit Comment Collapser",
   "options_ui": {
      "page": "views/options.html"
   },
   "permissions": [ "storage" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "6.0.1",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "image/collapse.png", "image/collapse-dark.png", "image/expand.png", "image/expand-dark.png", "image/colours/*" ]
   } ]
}
