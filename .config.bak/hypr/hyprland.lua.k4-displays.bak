hl.on("hyprland.start", function()
    hl.exec_cmd("/usr/lib/pam_kwallet_init")
    hl.exec_cmd("sleep 10 & kstart plasmashell")
    --hl.exec_cmd("noctalia")
    hl.exec_cmd("quickshell")
    hl.exec_cmd(terminal .. " --detach=yes --hold sh -c  \"watch -n 15 kbuildsycoca6 --noincremental 1>/dev/null 2>/dev/null & disown\"")
    hl.exec_cmd("nm-applet &")
    hl.exec_cmd("clearCaches1")
    hl.exec_cmd("clearCaches2")
    hl.exec_cmd("hyprmod")
    hl.exec_cmd("anyrun daemon")
    hl.exec_cmd("hyprpm reload -n")
    hl.exec_cmd("hyprpaper & yakuake & vivaldi")
    hl.exec_cmd("systemctl --user start sunshine.service")
    hl.exec_cmd("systemctl --user start app-dev.lizardbyte.app.Sunshine.service")
    hl.exec_cmd("obsidian")
    --hl.exec_cmd("hyprpanel")
    hl.exec_cmd("wl-paste --type text --watch bash -c 'cliphist store && qs -c $qsConfig ipc call cliphistService update'")
    hl.exec_cmd("wl-paste --type image --watch bash -c 'cliphist store && qs -c $qsConfig ipc call cliphistService update'")
    hl.exec_cmd(kstartWorking)
    hl.exec_cmd(speedhack)
    hl.exec_cmd("sleep 3.5 && hyprctl reload && sleep 0.5 && touch ~/.config/quickshell/ii/shell.qml")
    hl.exec_cmd("gsettings set org.gnome.desktop.interface gtk-theme 'Breeze'")
    hl.exec_cmd("google-chrome-stable")
    hl.exec_cmd("code", { workspace = "special:3 silent" })
    hl.exec_cmd("google-chrome-stable --incognito --database", { workspace = "special:3 silent" })
    hl.exec_cmd("steam", { workspace = "special:3 silent" })
    hl.exec_cmd("logseq", { workspace = "special:logseq silent" })
    hl.exec_cmd("betterbird", { workspace = "special:mail silent" })
    hl.exec_cmd("com.todoist.Todoist", { workspace = "special:todoist silent" })
    
hl.exec_cmd("hyprctl setcursor Layan-cursors 32")
    hl.exec_cmd("allusion", { workspace = "special:allusion silent" })
    hl.exec_cmd("youtube-music", { workspace = "special:youtube silent" })
end)


-- k4: atajos y arranque de la barra
require("config.k4")
