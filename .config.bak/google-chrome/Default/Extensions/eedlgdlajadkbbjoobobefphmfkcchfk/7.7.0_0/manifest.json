{
   "action": {
      "browser_style": false,
      "default_icon": "img/icon24.png",
      "default_title": "__MSG_browser_action_hover__"
   },
   "background": {
      "service_worker": "background.js"
   },
   "chrome_settings_overrides": {
      "search_provider": {
         "encoding": "UTF-8",
         "favicon_url": "https://www.ecosia.org/static/icons/favicon.ico",
         "is_default": true,
         "keyword": "ecosia.org",
         "name": "Ecosia",
         "prepopulated_id": 101,
         "search_url": "https://www.ecosia.org/search?q={searchTerms}&addon=chrome&addonversion=7.7.0&method=topbar",
         "suggest_url": "https://ac.ecosia.org/?q={searchTerms}&type=list&mkt=__MSG_@@ui_locale__"
      }
   },
   "content_scripts": [ {
      "js": [ "funnel.js" ],
      "matches": [ "*://*.ecosia.org/*" ],
      "run_at": "document_start"
   } ],
   "default_locale": "en",
   "description": "__MSG_store_shortdesc__",
   "externally_connectable": {
      "matches": [ "*://*.ecosia.org/*" ]
   },
   "homepage_url": "https://www.ecosia.org",
   "host_permissions": [ "*://*.ecosia.org/*" ],
   "icons": {
      "128": "img/logo_square_transparent128.png",
      "16": "img/favicon16.png",
      "32": "img/favicon32.png",
      "48": "img/logo_square_transparent48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "__MSG_store_title__",
   "permissions": [ "cookies" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "7.7.0"
}
