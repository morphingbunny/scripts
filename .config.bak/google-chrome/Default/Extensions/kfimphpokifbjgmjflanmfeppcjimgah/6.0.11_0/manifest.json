{
   "action": {
      "default_popup": ""
   },
   "author": "Innologica",
   "background": {
      "service_worker": "js/background.js",
      "type": "module"
   },
   "content_scripts": [ {
      "exclude_matches": [ "*://blog.inoreader.com/*", "*://translate.inoreader.com/*", "*://status.inoreader.com/*", "*://test.inoreader.com/*", "*://support.inoreader.com/*" ],
      "js": [ "js/page.js" ],
      "matches": [ "*://*.inoreader.com/*" ]
   } ],
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'"
   },
   "description": "Save articles for later and keep up with your favorite feeds. Discover, preview, and follow RSS feeds while organizing your content.",
   "externally_connectable": {
      "matches": [ "http://*/*", "https://*/*" ]
   },
   "host_permissions": [ "*://*.inoreader.com/*" ],
   "icons": {
      "128": "/icons/128_x_128_pixels.png",
      "16": "/icons/16_x_16_pixels.png",
      "48": "/icons/48_x_48_pixels.png"
   },
   "key": "MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQCJZ12UDTRm0hIgOaiMzovc2gCb6W5ymlpUA/+TC+3PgKgJuu3hWKiYw23u7reSXN0A+51mcGaIDhrEiiIVkYkGg2FURIzQ0srYvwqNDgYG+2su9+QLUVxwqwnWVAtntSbPYU4PMP4+9YnisM6wPT2AvClulwc0Ax5MgMTZFeOl8QIDAQAB",
   "manifest_version": 3,
   "name": "Inoreader: Read-later and RSS extension",
   "optional_host_permissions": [ "http://*/*", "https://*/*" ],
   "optional_permissions": [ "tabs", "declarativeNetRequestWithHostAccess", "webNavigation" ],
   "options_ui": {
      "open_in_tab": true,
      "page": "options.html"
   },
   "permissions": [ "activeTab", "storage", "contextMenus", "scripting" ],
   "short_name": "Inoreader",
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "6.0.11",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "toast.html", "/images/*" ]
   } ]
}
